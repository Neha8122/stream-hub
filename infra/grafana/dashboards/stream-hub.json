{
  "uid": "stream-hub",
  "title": "stream-hub",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Error budget left (30 days, from the 6 h ratio)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:home_fast:error_ratio_6h / 0.01",
          "legendFormat": "fast"
        },
        {
          "refId": "B",
          "expr": "1 - slo:home_complete:error_ratio_6h / 0.01",
          "legendFormat": "complete"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Burn rate (1 = budget lasts exactly 30 days; page above 14.4)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:home_fast:error_ratio_5m / 0.01",
          "legendFormat": "fast 5m"
        },
        {
          "refId": "B",
          "expr": "slo:home_complete:error_ratio_5m / 0.01",
          "legendFormat": "complete 5m"
        },
        {
          "refId": "C",
          "expr": "slo:home_complete:error_ratio_1h / 0.01",
          "legendFormat": "complete 1h"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency by service (p50 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{application}} p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (application, le) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{application}} p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests / s by service and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Degraded pages by dependency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (rate(home_degraded_total[1m]))",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit breaker state (1 = in this state)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state{state=~\"open|half_open\"}",
          "legendFormat": "{{name}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Catalog cache: hit / stale / miss",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(catalog_cache_total[1m]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "rate(catalog_cache_redis_errors_total[1m])",
          "legendFormat": "redis errors"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "History consumer: events processed and lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(spring_kafka_listener_seconds_count{application=\"history-service\"}[1m]))",
          "legendFormat": "processed / s"
        },
        {
          "refId": "B",
          "expr": "sum(kafka_consumer_fetch_manager_records_lag_max{application=\"history-service\"})",
          "legendFormat": "lag (records)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Search: hybrid vs keyword-only (model slow or busy)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(catalog_search_total[1m]))",
          "legendFormat": "{{mode}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(catalog_search_embed_skipped_total[1m]))",
          "legendFormat": "skipped: {{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Recs: playback events into the taste store",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(recs_events_total[1m]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source) (rate(recs_requests_total[1m]))",
          "legendFormat": "for-you: {{source}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Assistant: answers by mode (llm / cached / fallback / refused)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, reason) (rate(assistant_answers_total[1m]))",
          "legendFormat": "{{mode}} {{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Assistant: tokens / min and guardrail hits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(assistant_tokens_total[1m])) * 60",
          "legendFormat": "{{kind}} tokens/min"
        },
        {
          "refId": "B",
          "expr": "sum by (type) (rate(assistant_guardrail_total[1m])) * 60",
          "legendFormat": "guardrail {{type}}/min"
        }
      ]
    }
  ]
}